#!/usr/bin/env bash
# Launch a separate Airloom instance in debug mode without disrupting any
# other instance. Debug mode uses Gio.ApplicationFlags.NON_UNIQUE, and a
# live socket at the same path is refused rather than replaced. The script
# picks a default AIRLOOM_DEBUG_SOCKET if the caller didn't set one and
# execs the repo's ./run so this script's PID becomes Airloom's PID (useful
# for callers that want to `kill` it directly, though the debug port's own
# `quit` command is the preferred way to stop it).
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

export AIRLOOM_DEBUG_SOCKET="${AIRLOOM_DEBUG_SOCKET:-${XDG_RUNTIME_DIR:-/tmp}/airloom-debug.sock}"
echo "airloom debug socket: ${AIRLOOM_DEBUG_SOCKET}" >&2

exec "${project_dir}/run" "$@"
